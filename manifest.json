{
  "manifest_version": 3,
  "name": "X Bookmarks Exporter",
  "version": "1.1.0",
  "description": "Xのブックマークを取得してMarkdownファイルに出力します",
  "permissions": [
    "cookies",
    "storage",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
